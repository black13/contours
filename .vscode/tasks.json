{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build contours",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build -j4",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "silent",
                "focus": false
            }
        },
        {
            "label": "rebuild contours",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build -j4 --clean-first",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "cmake configure",
            "type": "shell",
            "command": "cmake -B ${workspaceFolder}/build -S ${workspaceFolder} -DCMAKE_BUILD_TYPE=Debug",
            "problemMatcher": []
        }
    ]
}
